[Unit]
Description=Refresh the YouTube cookie export when it stops working
Documentation=file:@REPO@/scripts/refresh-cookies.sh

[Service]
Type=oneshot

# The paths below are filled in by scripts/install-cookie-timer.sh. They are
# absolute because a user unit starts with no working directory — and that is
# exactly what broke: the unit named a repository path that had been renamed,
# and every run failed with 203/EXEC, which shows up nowhere in a timer list.
# Regenerating the unit is one command now, so moving the checkout costs nothing.
#
# The deploy argument is "--deploy user@host:/path" when the server is another
# machine, and empty when the refresh happens on the host that serves the
# downloads.
ExecStart=@REPO@/scripts/refresh-cookies.sh --output @OUTPUT@ --browser @BROWSER@ @DEPLOY_ARG@

# The script exits 1 when the export could not be refreshed. That is worth
# knowing but not worth restarting over: the next run will try again.
SuccessExitStatus=0 1
TimeoutStartSec=5min

# The keyring is what makes --cookies-from-browser work, and it lives in the
# session bus. Without these the service cannot decrypt anything.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
